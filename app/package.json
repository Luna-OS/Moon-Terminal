{
  "name": "moon-terminal",
  "version": "0.1.1",
  "description": "A standalone Windows terminal app for Claude Code, in Moon Dark theme.",
  "main": "main.js",
  "author": "Luna",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never && electron-builder --win portable --x64 --publish never",
    "dist:publish": "electron-builder --win nsis --x64 --publish always && electron-builder --win portable --x64 --publish always"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "os.luna.moonterminal",
    "productName": "Moon Terminal",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Luna-OS",
        "repo": "Moon-Terminal",
        "releaseType": "release"
      }
    ]
  }
}
